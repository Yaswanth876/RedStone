# Server Port (Render injects PORT automatically)
PORT=4000

# Allowed CORS origins (comma-separated for multiple origins, e.g. local dev + Vercel production)
CLIENT_ORIGIN=http://localhost:5173,https://your-redstone-app.vercel.app

# Set to true to allow Vercel dynamic preview deployments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# Managed PostgreSQL Connection URL (e.g., Render PostgreSQL, Supabase, Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/redstone?sslmode=require

# JWT Configuration (Minimum 32 characters in production)
JWT_SECRET=generate-a-secure-random-32-plus-char-secret-for-production
JWT_EXPIRES_IN=7d

# Express request body & upload limits
JSON_BODY_LIMIT=1mb
UPLOAD_MAX_BYTES=10485760

# Rate limiting for auth endpoints (requests per 15 minutes)
AUTH_RATE_LIMIT=100

# Prometheus Metrics Scraping Token (Bearer token protection for /metrics)
METRICS_TOKEN=generate-a-secure-random-metrics-token

# Node environment (production / development / test)
NODE_ENV=production
